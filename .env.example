# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/forge_os?retryWrites=true&w=majority

# Application PIN for single-user authentication (Required - min 4 digits, fail-closed)
APP_ACCESS_PIN=1234

# Cloudinary (Optional - for image/attachment hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
